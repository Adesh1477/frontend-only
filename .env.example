# CivicPulse Environment Variables (Phase 4 Real Computer Vision)
# Copy to .env and configure with your real Roboflow / Vision API key

# Roboflow Computer Vision API Key (Primary Civic Model)
# Get a key at: https://roboflow.com/
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=civic_issues_v1-dc7ae-zzdgj/1
ROBOFLOW_CONFIDENCE_THRESHOLD=0.40

# Google Gemini Multimodal Vision API Key (Secondary Provider)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Vision API Key (Alternative Provider)
OPENAI_API_KEY=

# Backend API Port (for standalone server execution)
PORT=3001
